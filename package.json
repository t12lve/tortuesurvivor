{
  "name": "tortuesurvivor",
  "version": "1.0.0",
  "description": "Tortue Survivor - Jeu de survie politique",
  "main": "electron_main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.vibecoding.tortuesurvivor",
    "productName": "TortueSurvivor",
    "directories": {
      "output": "dist_portable"
    },
    "win": {
      "target": "portable",
      "icon": "source/tortuesurvivor_256.ico"
    },
    "portable": {
      "artifactName": "TortueSurvivor.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "source/tortuesurvivor_256.ico",
      "uninstallerIcon": "source/tortuesurvivor_256.ico",
      "artifactName": "TortueSurvivor-Installer.exe"
    },
    "files": [
      "**/*",
      "!dist*",
      "!dist_clean*",
      "!dist_final*",
      "!dist_portable*",
      "!node_modules*",
      "!temp_*",
      "!neutralino_*",
      "!build_exe.js",
      "!**/*.psd",
      "!source/animations/pixelbg_mov.webm"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
